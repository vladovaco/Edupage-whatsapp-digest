# ===== Edupage =====
# Prihlasovacie údaje rodičovského (alebo žiackeho) konta
EDUPAGE_USERNAME=meno@example.com
EDUPAGE_PASSWORD=tajneheslo
# Subdoména školy: z adresy https://mojaskola.edupage.org je to "mojaskola"
EDUPAGE_SUBDOMAIN=mojaskola
# Voliteľné: person_id dieťaťa, ak má rodičovské konto viac detí
# EDUPAGE_CHILD_ID=12345

# ===== WhatsApp Cloud API (Meta) =====
# Návod: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Tvoje číslo v medzinárodnom formáte (bez + je tiež OK)
WHATSAPP_RECIPIENT=421900123456
# WHATSAPP_API_VERSION=v21.0
# Voliteľné: schválená šablóna správy – doručí sa aj mimo 24-hodinového okna.
# Telo šablóny musí mať jednu premennú {{1}} (vloží sa do nej text digestu).
# WHATSAPP_TEMPLATE_NAME=edupage_digest
# WHATSAPP_TEMPLATE_LANG=sk
# Poslať okrem hlasovky aj textovú verziu digestu (true/false)
SEND_TEXT_TOO=true

# ===== Digest =====
# Koľko dní dozadu sa pozerať pri prvom spustení
DIGEST_DAYS=2
# Voliteľné: Claude API kľúč pre prirodzené hovorené zhrnutie.
# Bez neho sa použije jednoduché šablónové zhrnutie.
# ANTHROPIC_API_KEY=sk-ant-...

# ===== Webhook server (len pre režim „na požiadanie cez WhatsApp správu") =====
WEBHOOK_VERIFY_TOKEN=edupage-digest
WEBHOOK_PORT=8000
